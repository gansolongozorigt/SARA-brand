# WooCommerce read-proxy credentials (server-side only — NEVER prefix with VITE_).
# Copy this file to .env.local (gitignored) for local `vercel dev` testing.
# In Vercel these three are set for Production and Preview (marked Sensitive);
# Development is intentionally unset there, so local runs read from .env.local.

# WooCommerce site base URL (the function appends /wp-json/wc/v3).
WOO_API_URL=https://api.sarabrand.mn

# REST API key "SARA Frontend" (Read). Query-string auth is used (this host
# strips the Authorization header, so Basic Auth 401s).
WOO_CONSUMER_KEY=ck_your_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here

# Order creation (Phase C) — a SEPARATE WooCommerce key with Read/Write scope.
# Only api/order-submit.ts uses this; the read proxy stays read-only.
WOO_WRITE_KEY=ck_your_write_key_here
WOO_WRITE_SECRET=cs_your_write_secret_here

# Optional: Web3Forms access key for the server-side order email. Falls back to
# the existing shared key if unset.
# WEB3FORMS_ACCESS_KEY=your_web3forms_key

# Reseller Google Sign-In (Phase A1) — server-side only, NEVER prefix with VITE_.
# Registered redirect URI in Google Cloud: {origin}/api/auth-callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# 48+ char URL-safe random string; e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(48))"`
SESSION_SECRET=your_long_random_session_secret
